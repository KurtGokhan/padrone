{
  "name": "@padrone/tasks-example",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "module": "src/tasks.ts",
  "exports": {
    ".": "./src/tasks.ts"
  },
  "bin": "src/tasks.ts",
  "scripts": {
    "start": "bun --conditions=padrone@dev src/tasks.ts",
