{
  "name": "@padrone/tasks-example",
  "version": "1.8.1",
  "private": true,
  "type": "module",
  "module": "src/tasks.ts",
  "exports": {
    ".": "./src/tasks.ts"
  },
  "bin": "src/tasks.ts",
  "scripts": {
    "start": "bun --conditions=padrone@dev src/tasks.ts",
    "ai": "bun --conditions=padrone@dev run src/ai.ts",
    "dev": "bun --conditions=padrone@dev run --watch src/tasks.ts"
  },
  "dependencies": {
    "ai": "^6.0.146",
    "ink": "^6.8.0",
    "padrone": "workspace:*",
    "react": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.14"
  }
}
