// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`docs generateDocs markdown snapshot for show command 1`] = `
"# show

## Usage

\`\`\`
padrone-test show <id> [options]
\`\`\`

## Arguments

- \`id\` *(string)* — Task ID

## Options

#### \`--priority\`

Priority level

**Type:** \`string\` | **Optional** | **Default:** \`medium\` | **Choices:** \`low\`, \`medium\`, \`high\`

#### \`--[no-]verbose\`

Show detailed information

**Type:** \`boolean\` | **Optional**
"
`;

exports[`docs generateDocs html snapshot for show command 1`] = `
