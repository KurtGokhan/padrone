    <dd>Task ID</dd>
  </dl>
  <h2>Options</h2>
  <dl>
    <dt><code>--priority</code> <span class="type">string</span></dt>
    <dd>Priority level</dd>
    <dd class="meta">Optional · Default: <code>medium</code> · Choices: <code>low</code>, <code>medium</code>, <code>high</code></dd>
    <dt><code>--[no-]verbose</code> <span class="type">boolean</span></dt>
    <dd>Show detailed information</dd>
    <dd class="meta">Optional</dd>
  </dl>
</article>
"
`;

exports[`docs generateDocs man snapshot for show command 1`] = `
".TH "SHOW" "1" "" "" ""
.SH NAME
show
.SH SYNOPSIS
\\fBshow\\fR \\fIid\\fR [\\fIoptions\\fR]
.SH ARGUMENTS
.TP
