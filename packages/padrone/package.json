{
  "name": "padrone",
  "version": "1.6.0",
  "description": "Create type-safe, interactive CLI apps with Zod schemas",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "sideEffects": false,
  "keywords": [
    "cli",
    "command-line",
    "zod",
    "typescript",
    "type-safe",
    "parser",
    "arguments",
    "options",
    "ai",
    "vercel-ai",
    "standard-schema"
  ],
  "homepage": "https://github.com/KurtGokhan/padrone",
  "bugs": {
    "url": "https://github.com/KurtGokhan/padrone/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KurtGokhan/padrone.git"
  },
  "author": {
    "name": "Gokhan Kurt",
    "email": "gokhan@gkurt.com",
    "url": "https://gkurt.com"
  },
  "files": [
    "dist/",
    "src/",
    "media/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {
    "padrone": "./src/cli/index.ts"
  },
  "imports": {
    "#*": "./*"
  },
  "exports": {
    ".": {
      "padrone@dev": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "source": "./src/index.ts"
    },
    "./test": {
      "padrone@dev": "./src/test.ts",
      "import": {
        "types": "./dist/test.d.mts",
        "default": "./dist/test.mjs"
      },
      "source": "./src/test.ts"
    },
    "./codegen": {
      "padrone@dev": "./src/codegen/index.ts",
      "import": {
        "types": "./dist/codegen.d.mts",
        "default": "./dist/codegen.mjs"
      },
      "source": "./src/codegen/index.ts"
    },
    "./docs": {
      "padrone@dev": "./src/docs/index.ts",
      "import": {
        "types": "./dist/docs.d.mts",
        "default": "./dist/docs.mjs"
      },
      "source": "./src/docs/index.ts"
    },
    "./zod": {
      "padrone@dev": "./src/zod.ts",
      "import": {
        "types": "./dist/zod.d.mts",
        "default": "./dist/zod.mjs"
      },
      "source": "./src/zod.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/test.ts src/zod.ts src/codegen/index.ts src/docs/index.ts --dts --sourcemap",
    "start": "bun --conditions=padrone@dev src/cli/index.ts",
    "dev": "bun --conditions=padrone@dev --watch src/cli/index.ts",
    "test": "bun test --conditions=padrone@dev",
    "link": "bun start link",
    "unlink": "bun start unlink",
    "prepack": "bun run build && bun ../../scripts/prepareForRelease.ts"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "enquirer": "^2.4.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "ai": "^6.0.141",
    "ink": "^6.8.0",
    "react": "^19.2.4",
    "tsdown": "^0.21.6",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "ai": "5 || 6",
    "ink": "^6.0.0",
    "react": ">=18.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "ink": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
